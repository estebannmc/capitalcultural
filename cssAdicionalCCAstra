.cc-menu.active .cc-menu-toggle span:nth-child(2) {
  opacity: 0;
}

.cc-menu.active .cc-menu-toggle span:nth-child(3) {
  transform: translateY(-8px) rotate(-45deg);
}

/* ==========================================================================
   09. PANEL FULLSCREEN
   ========================================================================== */

.cc-menu-panel {
