}

/* Links */
.cc-menu-panel a {
  color: #ffffff !important;
  text-decoration: none;
  font-size: 15px;
  font-weight: 500;
  line-height: 1.2;
  transition: 0.2s ease;
  display: block;
}

.cc-menu-panel a:hover {
