/* ==========================================================================
   10. MOBILE HEADER / MENU
   ========================================================================== */

@media (max-width: 768px) {
  .cc-header {
    padding: 18px 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }

  .cc-header-logo img {
    width: 165px;
    height: auto;
  }

  .cc-menu-toggle {
    width: 40px;
    height: 40px;
    flex-shrink: 0;
  }

  .cc-menu-panel {
    padding: 100px 25px 40px;
  }

  .cc-menu-panel ul {
    max-width: 100%;
  }

  .cc-menu-panel a {
    font-size: 14px;
  }
}

/* ==========================================================================
   11. QUITAR BORDE, SOMBRA Y HOVER EN IMAGENES / LINKS
   ========================================================================== */

img,
a img,
.elementor img,
.elementor a img {
  box-shadow: none !important;
  border: none !important;
  outline: none !important;
}

a:hover img,
.elementor a:hover img {
  box-shadow: none !important;
  border: none !important;
  outline: none !important;
  filter: none !important;
  opacity: 1 !important;
  transform: none !important;
}


/* ==========================================================================
   13. BOTONES GRID - ORIGINAL CON CORRECCION DE HOVER
   ========================================================================== */

/* Botones grid */
.cb-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 18px;
}

/* Boton */
.cb-btn {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 80px;
  padding: 0 10px;
  text-decoration: none;
  background: #002751;
  color: #ffffff !important;
  border: 1px solid #002751;
  overflow: hidden;
  box-sizing: border-box;
  transition: background .4s cubic-bezier(.22, 1, .36, 1), color .3s ease, border-color .3s ease;
}

/* Texto del boton */
.cb-btn span {
  font-weight: 700;
  font-size: 17px;
  color: #ffffff !important;
  text-align: center;
  line-height: 1.2;
  position: relative;
  z-index: 2;
  transition:
    transform .45s cubic-bezier(.22, 1, .36, 1),
    color .3s ease;
}

/* Barra del hover */
.cb-btn::before {
  content: "";
  position: absolute;
  top: 50%;
  left: var(--cb-bar-left, 20px);
  width: 4px;
  height: 32px;
  background: #e63312;
  transform:
    translateY(-50%)
    rotate(15deg)
    scaleY(0);
  opacity: 0;
  transition:
    transform .6s cubic-bezier(.19, 1, .22, 1),
    opacity .3s ease;
}

/* Hover corregido:
   - evita que Astra/Elementor pinte el texto verde por herencia;
   - mantiene el boton blanco en hover;
   - conserva la barra roja antes del texto. */
.cb-btn:hover,
.cb-btn:focus-visible {
  background: #ffffff;
  color: #002751 !important;
  border-color: #ffffff;
}

.cb-btn:hover span,
.cb-btn:focus-visible span {
  color: #002751 !important;
  transform: translateX(12px);
}

.cb-btn:hover::before,
.cb-btn:focus-visible::before {
  transform:
    translateY(-50%)
    rotate(15deg)
    scaleY(1);
  opacity: 1;
}
